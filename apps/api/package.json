    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@sakan/shared": "workspace:*",
    "bullmq": "^6.3.15",
    "dotenv": "^17.0.0",
    "ioredis": "^6.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
