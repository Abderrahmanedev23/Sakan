// Sakan data model.
// Database: MySQL 8. UUIDs are CHAR(36); free-form text that can exceed 191 chars is TEXT.
// Money is stored as integer minor units (centimes) to avoid float rounding.
// Enums are mirrored in packages/shared/src/enums.ts for clients.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "mysql"
}

// ─── Users & identity verification ───────────────────────────────────────────

enum UserRole {
  USER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

enum VerificationStatus {
  UNSUBMITTED
  PENDING
  APPROVED
  REJECTED
}

enum IdentityDocumentSide {
  FRONT
  BACK
}

model User {
  id                 String             @id @default(uuid()) @db.Char(36)
  email              String             @unique
  phone              String?            @unique
  passwordHash       String
  role               UserRole           @default(USER)
  accountStatus      AccountStatus      @default(ACTIVE)
  verificationStatus VerificationStatus @default(UNSUBMITTED)

  firstName    String?
  lastName     String?
  dateOfBirth  DateTime? @db.Date
  /// Moroccan National Identity Card number. Unique: one account per person.
  cinNumber    String?   @unique
  cinExpiresAt DateTime? @db.Date

  /// When the current CIN details and scans were submitted for review.
  identitySubmittedAt DateTime?
  verifiedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  authSessions      AuthSession[]
  identityDocuments IdentityDocument[]
  reviewsReceived   VerificationReview[] @relation("ReviewSubject")
  reviewsGiven      VerificationReview[] @relation("ReviewReviewer")
  payments          Payment[]
  entries           Entry[]
  sessionsCreated   DrawSession[]
  auditLogs         AuditLog[]

  @@index([verificationStatus, identitySubmittedAt])
}

/// A signed-in device. The client holds the random token; only its SHA-256 is stored,
/// so a database leak does not leak usable tokens. Revoked on logout and suspension.
model AuthSession {
  id        String    @id @default(uuid()) @db.Char(36)
  userId    String    @db.Char(36)
  tokenHash String    @unique
  userAgent String?   @db.Text
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A CIN scan stored in private object storage. Only the storage key is kept here.
/// A resubmission supersedes the previous scans instead of deleting them, for the audit trail.
model IdentityDocument {
  id           String               @id @default(uuid()) @db.Char(36)
  userId       String               @db.Char(36)
  side         IdentityDocumentSide
  storageKey   String               @unique
  mimeType     String
  sizeBytes    Int
  sha256       String
  uploadedAt   DateTime             @default(now())
  supersededAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Append-only history of admin approval / rejection decisions.
model VerificationReview {
  id         String             @id @default(uuid()) @db.Char(36)
  userId     String             @db.Char(36)
  reviewerId String             @db.Char(36)
  decision   VerificationStatus
  reason     String?            @db.Text
  createdAt  DateTime           @default(now())

  user     User @relation("ReviewSubject", fields: [userId], references: [id], onDelete: Cascade)
  reviewer User @relation("ReviewReviewer", fields: [reviewerId], references: [id])

  @@index([userId])
}

// ─── Draw sessions ───────────────────────────────────────────────────────────

enum SessionStatus {
  DRAFT
  OPEN
  PAUSED
  FULL
  SCHEDULED
  COMPLETED
  CANCELLED
}

model DrawSession {
  id          String        @id @default(uuid()) @db.Char(36)
  /// Short public number used in entry references, e.g. 1 → SKN-0001-000042.
  number      Int           @unique @default(autoincrement())
  name        String
  description String?       @db.Text
  status      SessionStatus @default(DRAFT)

  entryPriceCents   Int
  currency          String  @default("MAD")
  targetEntries     Int
  /// Count of entries backed by a confirmed payment. Updated in the same transaction as the entry.
  confirmedEntries  Int     @default(0)
  /// When false, the session never accepts more than targetEntries.
  allowOverfill     Boolean @default(false)
  maxEntriesPerUser Int?
  winnerCount       Int     @default(1)

  /// Local time of day (HH:mm) the draw runs once the target is reached, e.g. "18:00".
  drawTimeOfDay    String @default("18:00")
  timezone         String @default("Africa/Casablanca")
  /// When set, the draw runs this many minutes after the session fills instead of at drawTimeOfDay.
  drawDelayMinutes Int?

  opensAt         DateTime?
  closesAt        DateTime?
  filledAt        DateTime?
  drawScheduledAt DateTime?

  createdById String   @db.Char(36)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User      @relation(fields: [createdById], references: [id])
  payments  Payment[]
  entries   Entry[]
  draw      Draw?

  @@index([status])
}

// ─── Payments & entries ──────────────────────────────────────────────────────

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model Payment {
  id          String        @id @default(uuid()) @db.Char(36)
  /// Human-readable unique reference shown to the user, e.g. PAY-7K3F9Q2M.
  reference   String        @unique
  userId      String        @db.Char(36)
  sessionId   String        @db.Char(36)
  amountCents Int
  currency    String        @default("MAD")
  status      PaymentStatus @default(PENDING)

  provider              String
  providerTransactionId String?
  /// Client-supplied key so a retried request never creates a second payment.
  idempotencyKey        String    @unique
  failureReason         String?   @db.Text
  /// Where the client sends the user to pay; returned again when a request is retried.
  checkoutUrl           String?   @db.Text
  /// A PENDING payment holds a place in the session until this time.
  expiresAt             DateTime?
  /// Raw provider callback payload, kept for disputes.
  providerPayload       Json?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  confirmedAt DateTime?
  refundedAt  DateTime?

  user    User        @relation(fields: [userId], references: [id])
  session DrawSession @relation(fields: [sessionId], references: [id])
  entry   Entry?

  /// The same provider transaction can never be processed twice.
  @@unique([provider, providerTransactionId])
  @@index([sessionId, status])
  @@index([userId])
  @@index([status, expiresAt])
}

enum EntryStatus {
  ACTIVE
  VOID
}

/// One participation in a session. Created only from a succeeded payment.
model Entry {
  id        String      @id @default(uuid()) @db.Char(36)
  /// Public unique reference, e.g. SKN-0001-002917.
  reference String      @unique
  sessionId String      @db.Char(36)
  userId    String      @db.Char(36)
  paymentId String      @unique @db.Char(36)
  /// 1-based position within the session; the draw picks a sequence number.
  sequence  Int
  status    EntryStatus @default(ACTIVE)
  createdAt DateTime    @default(now())

  session DrawSession  @relation(fields: [sessionId], references: [id])
  user    User         @relation(fields: [userId], references: [id])
  payment Payment      @relation(fields: [paymentId], references: [id])
  wins    DrawWinner[]

  @@unique([sessionId, sequence])
  @@index([userId])
}

// ─── Draws ───────────────────────────────────────────────────────────────────

enum DrawStatus {
  SCHEDULED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

/// The single official draw of a session (sessionId is unique).
/// Uses commit-reveal: seedHash is published when the draw is scheduled.
/// seed is stored at the same time but must only be exposed once the draw is
/// COMPLETED, so anyone can then recompute the winner.
model Draw {
  id          String     @id @default(uuid()) @db.Char(36)
  sessionId   String     @unique @db.Char(36)
  status      DrawStatus @default(SCHEDULED)
  scheduledAt DateTime

  seedHash    String
  seed        String?
  /// SHA-256 of the ordered list of eligible entry references at draw time.
  entriesHash String?
  entryCount  Int?

  startedAt   DateTime?
  completedAt DateTime?
  /// Last error when a run failed; the job retries and an admin can retry by hand.
  lastError   String?   @db.Text
  createdAt   DateTime  @default(now())

  session DrawSession  @relation(fields: [sessionId], references: [id])
  winners DrawWinner[]
}

model DrawWinner {
  id       String @id @default(uuid()) @db.Char(36)
  drawId   String @db.Char(36)
  entryId  String @db.Char(36)
  /// 1 for the first prize, 2 for the second, ...
  position Int

  draw  Draw  @relation(fields: [drawId], references: [id])
  entry Entry @relation(fields: [entryId], references: [id])

  @@unique([drawId, position])
  @@unique([drawId, entryId])
}

// ─── Audit ───────────────────────────────────────────────────────────────────

/// Append-only log of important operations. Never updated or deleted by the app.
model AuditLog {
  id         String   @id @default(uuid()) @db.Char(36)
  actorId    String?  @db.Char(36)
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
}
