NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://sakan:sakan@localhost:5432/sakan
REDIS_URL=redis://localhost:6379
# Comma-separated origins allowed to call the API (web app, later the mobile dev server).
CORS_ORIGINS=http://localhost:3000
PAYMENT_PROVIDER=stub
# Days a sign-in stays valid before the user has to sign in again.
AUTH_SESSION_TTL_DAYS=30
# Where CIN scans are stored: "local" (a directory on this machine) or "s3" (a private bucket).
# Use "s3" on hosts whose disk is wiped on restart, such as Render's free plan.
STORAGE_DRIVER=local
# local: private directory for CIN scans. Never serve it statically; back it up and encrypt it at rest.
PRIVATE_STORAGE_DIR=storage/private
# s3: any S3-compatible store. For Supabase Storage the endpoint is
# https://<project-ref>.storage.supabase.co/storage/v1/s3, the region is the project's (e.g. eu-central-1)
# and S3_FORCE_PATH_STYLE=true. For Cloudflare R2 it is https://<account-id>.r2.cloudflarestorage.com, region "auto".
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=
# Set when running behind a reverse proxy so client IPs are logged correctly (e.g. 1).
TRUST_PROXY=
