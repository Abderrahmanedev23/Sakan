{
  "name": "sakan",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "dev:api": "pnpm --filter @sakan/api dev",
    "dev:web": "pnpm --filter @sakan/web dev",
    "typecheck": "pnpm -r typecheck",
    "db:up": "docker compose up -d postgres redis",
    "db:migrate": "pnpm --filter @sakan/api prisma:migrate",
    "db:generate": "pnpm --filter @sakan/api prisma:generate"
  }
}
